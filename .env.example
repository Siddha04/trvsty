# ==========================================================
# Trusty - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.
# ==========================================================

# SurePass Verification API
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_API_TOKEN=your_surepass_bearer_token_here

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# App environment: development | staging | production
APP_ENV=development

# Backend webhook endpoint (Cloud Function) used to verify payment signatures.
# The Razorpay key SECRET must live ONLY on the server, never in the app.
PAYMENT_VERIFY_ENDPOINT=https://us-central1-trusty-app.cloudfunctions.net/verifyPayment
